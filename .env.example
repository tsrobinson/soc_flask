# Copy to soc_flask/.env and fill in keys. Never commit .env.
# (The repo-root .gitignore already excludes .env and .env.*.)

OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional — for testing open-weight models (Llama, Qwen, gpt-oss) via Groq's
# OpenAI-compatible API. Models are referenced as "groq/<model-id>" in requests.
GROQ_API_KEY=gsk_...

# Optional — for testing open-weight models via Together AI's OpenAI-compatible
# API (often cheaper than Groq, with higher free-tier limits). Models are
# referenced as "together/<model-id>" in requests.
TOGETHER_API_KEY=...

# Optional — only needed if you want retrieval through Pinecone.
# If not set, the API requires callers to provide 'soc_cands' explicitly.
PINECONE_API_KEY=pcsk_...
